### Title: Azure
### Description: Generato da Terraform, non modificare a mano

# risorse (foglie)
%{ for node, r in resources ~}
${node} = ${r.host};Hoststatus
%{ endfor ~}

# raggruppamento per dominio
%{ for domain, nodes in domains ~}
dom_${domain} = ${join(" & ", nodes)}
%{ endfor ~}

# radice
azure = ${join(" & ", [for d in keys(domains) : "dom_${d}"])}

display 1;azure;Azure
%{ for domain, nodes in domains ~}
display 2;dom_${domain};${domain}
%{ endfor ~}