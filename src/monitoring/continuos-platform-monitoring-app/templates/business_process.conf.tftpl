### Business Process Config File ###
#
# Title           : ${title}
# Description     : Generato da Terraform, non modificare a mano
# AddToMenu       : yes
#
###################################

# Host: Hoststatus + tutti i servizi dell'host, con il titolo "<tipo>: <nome>"
# (display 0 = non di primo livello)
%{ for host, h in hosts ~}
${host} = ${join(" & ", h.checks)}
display 0;${host};${h.title}
%{ endfor ~}

# Namespace AKS: un nodo per check, con il titolo (display 0 = non di primo livello)
%{ for node, n in namespaces ~}
${node} = ${n.check}
display 0;${node};${n.title}
%{ endfor ~}

# Domini: primo livello del Business Process. ${synthetic}_<dominio> è definito
# a runtime da azure-synthetic-monitoring tramite la bp-api
%{ for domain, hosts in domains ~}
${domain} = ${join(" & ", concat(hosts, ["${synthetic}_${domain}"]))}
display 1;${domain};${domain}
%{ endfor ~}

# Nodi di synthetic vuoti (stato EMPTY, non influiscono sul dominio): il modulo
# businessprocess non accetta riferimenti a nodi non definiti. La bp-api sostituisce
# l'intera sezione e mantiene vuoti i nodi richiamati senza blocchi
# begin ${synthetic} section
%{ for domain, hosts in domains ~}
${synthetic}_${domain} =
%{ endfor ~}
# end ${synthetic} section